{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "learny",
  "version": "0.1.0",
  "identifier": "com.narachara.learny",
"build": {
  "beforeDevCommand": "cd ui && dx build --platform web --release --debug-symbols false",
  "beforeBuildCommand": "cd ui && dx build --platform web --release --debug-symbols false",
  "devUrl": null,
  "frontendDist": "../target/dx/ui/release/web/public"
},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "learny",
        "width": 1200,
        "height": 1000
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "*"
        ]
      },
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  },
  "plugins": {}
}